{
  "name": "helix-visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Desktop graph explorer for HelixDB — SQL-like queries and a live force-directed graph view.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "mock": "node tools/mock-helix-server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@helix-db/helix-db": "^3.0.2",
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
